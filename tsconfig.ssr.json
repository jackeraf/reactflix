{
  "compilerOptions": {
    "outDir": "dist-ssr",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],            
    "module": "CommonJS",          
    "moduleResolution": "Node",
    "jsx": "react-jsx",            
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "server.ts",
    "src/entry-server.tsx",
    "src/App.tsx",
    "src/pages/**/*.tsx",
    "src/components/**/*.tsx",
    "src/api/**/*.ts",
    "src/routes/**/*.tsx",
    "src/store/**/*.ts",
    "src/types.ts",
    "src/constants.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "src/entry-client.tsx",
    "src/**/*.test.*",
    "node_modules",
    "dist",
    "dist-ssr"
  ]
}
